{
  "dashboard": {
    "host": "127.0.0.1",
    "port": 8787,
    "refreshSeconds": 10,
    "currency": {
      "source": "GBP",
      "sourceSymbol": "£",
      "target": "USD",
      "targetSymbol": "$",
      "rate": 1.336,
      "rateLabel": "1 GBP = 1.336 USD"
    }
  },
  "scraper": {
    "enabled": true,
    "headless": false,
    "intervalSeconds": 20,
    "alerts": {
      "enabled": true,
      "repeat": 2,
      "durationMs": 250,
      "gapMs": 120,
      "startFrequency": 1200,
      "stepFrequency": 200
    },
    "timezone": "Asia/Shanghai",
    "storeTimezone": "America/Anchorage",
    "storageStatePath": "data/auth-state.json",
    "ordersOutputPath": "data/orders.json",
    "dashboardDataPath": "public/data/summary.json",
    "adCapture": {
      "enabled": true,
      "outputPath": "public/data/ad-summary.json",
      "refreshBeforeRead": true
    },
    "backend": {
      "loginUrl": "https://example.com/admin/login",
      "ordersUrl": "https://example.com/admin/orders",
      "username": "",
      "password": "",
      "selectors": {
        "usernameInput": "input[type=\"email\"]",
        "passwordInput": "input[type=\"password\"]",
        "loginButton": "button.el-button--primary",
        "loggedInMarker": "table",
        "orderRows": "table tbody tr",
        "orderNumber": "[data-field=\"order-number\"]",
        "createdAt": "[data-field=\"created-at\"]",
        "amount": "[data-field=\"amount\"]",
        "status": "[data-field=\"status\"]",
        "landingUrl": "[data-field=\"landing-url\"]"
      }
    }
  }
}
