{
  "dashboard": {
    "host": "127.0.0.1",
    "port": 8787,
    "refreshSeconds": 10,
    "currency": {
      "source": "GBP",
      "sourceSymbol": "£",
      "target": "USD",
      "targetSymbol": "$",
      "rate": 1.336,
      "rateLabel": "1 GBP = 1.336 USD"
    }
  },
  "scraper": {
    "enabled": true,
    "headless": true,
    "intervalSeconds": 20,
    "alerts": {
      "enabled": true,
      "repeat": 2,
      "durationMs": 170,
      "gapMs": 140,
      "startFrequency": 620,
      "stepFrequency": 90,
      "soundPath": ""
    },
    "timezone": "Asia/Shanghai",
    "storeTimezone": "America/Anchorage",
    "storageStatePath": "data/auth-state.json",
    "ordersOutputPath": "data/orders.json",
    "dashboardDataPath": "public/data/summary.json",
    "adCapture": {
      "enabled": true,
      "outputPath": "public/data/ad-summary.json",
      "refreshBeforeRead": true,
      "intervalMinutes": 0,
      "controlPath": "data/ad-capture-control.json",
      "adAccountId": "",
      "ctid": "",
      "adAccountName": "",
      "campaignPageUrl": ""
    },
    "backend": {
      "loginUrl": "https://example.com/admin/login",
      "ordersUrl": "https://example.com/admin/orders",
      "username": "",
      "password": "",
      "selectors": {
        "usernameInput": "input[type=\"email\"]",
        "passwordInput": "input[type=\"password\"]",
        "loginButton": "button.el-button--primary",
        "loggedInMarker": "table",
        "orderRows": "table tbody tr",
        "orderNumber": "[data-field=\"order-number\"]",
        "createdAt": "[data-field=\"created-at\"]",
        "amount": "[data-field=\"amount\"]",
        "status": "[data-field=\"status\"]",
        "landingUrl": "[data-field=\"landing-url\"]"
      }
    }
  },
  "stores": [
    {
      "key": "store-a",
      "name": "Store A",
      "url": "https://store-a.example.com/",
      "scraper": {
        "storageStatePath": "data/stores/store-a/auth-state.json",
        "ordersOutputPath": "data/stores/store-a/orders.json",
        "dashboardDataPath": "public/data/stores/store-a/summary.json",
        "adCapture": {
          "outputPath": "public/data/stores/store-a/ad-summary.json",
          "controlPath": "data/stores/store-a/ad-capture-control.json",
          "adAccountId": "",
          "ctid": "",
          "adAccountName": "",
          "campaignPageUrl": ""
        },
        "backend": {
          "loginUrl": "https://store-a.example.com/admin",
          "ordersUrl": "https://store-a.example.com/admin/orderList",
          "username": "",
          "password": ""
        }
      }
    }
  ]
}
